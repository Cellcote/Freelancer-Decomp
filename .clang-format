# Formatting for first-party code under src/. Vendored libraries keep their own style
# (src/zlib/vendor, src/qhull/vendor carry a DisableFormat .clang-format).
#
# The tree is NOT bulk-reformatted: that would touch nearly every line and make upstream
# merges painful. CI checks only the lines a change touches (git clang-format). Reformat a
# whole file only in a commit of its own that changes nothing else.
Language: Cpp
BasedOnStyle: Microsoft
Standard: c++17
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
BreakBeforeBraces: Allman
PointerAlignment: Left
ReferenceAlignment: Left
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlignAfterOpenBracket: Align
AlignTrailingComments:
  Kind: Leave
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
BinPackArguments: true
BinPackParameters: true
# Include order is significant here (windows.h before mmsystem.h, DX8 after the Windows SDK).
SortIncludes: Never
IncludeBlocks: Preserve
# Retail-address comments and listing excerpts are hand-laid out.
ReflowComments: false
SpacesBeforeTrailingComments: 1
FixNamespaceComments: false
InsertBraces: false
KeepEmptyLines:
  AtStartOfBlock: true
MaxEmptyLinesToKeep: 2
